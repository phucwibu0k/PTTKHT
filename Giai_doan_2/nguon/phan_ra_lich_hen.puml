@startuml
left to right direction
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 14
skinparam dpi 180
skinparam shadowing false
actor "Bệnh nhân" as BN
actor "Lễ tân" as LT
rectangle "PHÂN RÃ: QUẢN LÝ LỊCH HẸN VÀ TIẾP NHẬN" {
usecase "UC01\nĐặt lịch khám" as U1
usecase "UC02\nĐổi lịch khám" as U2
usecase "UC03\nHủy lịch khám" as U3
usecase "UC04\nTiếp nhận bệnh nhân" as U4
usecase "UC08\nKiểm tra lịch trống" as U8
usecase "UC09\nGửi thông báo lịch hẹn" as U9
usecase "UC01.1\nXác định hồ sơ bệnh nhân\n--\nĐiểm mở rộng:\nSau tìm hồ sơ" as C1
usecase "UC01.2\nLập hồ sơ bệnh nhân mới" as C2
}
actor "Dịch vụ SMS" as SMS
BN -- U1
BN -- U2
BN -- U3
LT -- U1
LT -- U2
LT -- U3
LT -- U4
U1 ..> C1 : <<include>>
U4 ..> C1 : <<include>>
C2 ..> C1 : <<extend>>\n[lễ tân đặt hộ người mới]
U1 ..> U8 : <<include>>
U2 ..> U8 : <<include>>
U1 ..> U9 : <<include>>
U2 ..> U9 : <<include>>
U3 ..> U9 : <<include>>
U9 -- SMS
@enduml
